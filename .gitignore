# Data (never commit raw or processed datasets)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Checkpoints (exclude huge optimizer states & backups)
checkpoints/**/last.pth
checkpoints/*_prev_run/
checkpoints/*_backup/
checkpoints/dyda/fold_*

# Outputs (exclude backup folders)
outputs/*_prev_run/
outputs/*_backup/

# Temporary logs & notes
*.tmp
training_output*.log
ablation_run.log
training_dyda.log
training_status.txt
training_plan.txt
quick_train_estimate.txt
next_step.txt
Claude.md
Next prompts.md

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
*.egg-info/

# IDE / OS
.vscode/
.idea/
Thumbs.db
.DS_Store
